# Copy to .env and adjust. Every value below is also the built-in default,
# so a .env file is entirely optional.

# Default model alias (yolov8n, yolov8s, yolov8m, yolov8l, yolov8x, yolo11n...)
DEFAULT_MODEL=yolov8n.pt

# Detection defaults used when a request omits them
CONFIDENCE_THRESHOLD=0.5
IOU_THRESHOLD=0.45

# auto | cpu | cuda:0 | mps
DEVICE=auto

# Long edge is downscaled to this before inference; boxes are still reported in
# original image pixels. 0 disables downscaling.
MAX_IMAGE_SIZE=1280

# Request guards
MAX_UPLOAD_MB=25
MAX_IMAGE_PIXELS=64000000

# Load the default model at API startup instead of on the first request
PRELOAD_MODEL=0

# Loading a .pt file executes pickle data. Keep this enabled only while the API
# is bound to localhost; set to 0 before exposing the API to a network.
ALLOW_CUSTOM_MODEL_UPLOAD=1

# Where uploaded / custom .pt weights live
MODELS_DIR=models

# Comma-separated browser origins allowed to call the API
CORS_ORIGINS=*

# Frontend: where the Streamlit app looks for the API
API_URL=http://127.0.0.1:8000
